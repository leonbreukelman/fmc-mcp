# FMC MCP Server Configuration
# Copy this file to .env and fill in your FMC credentials

# Required: FMC connection details
FMC_HOST=fmc.example.com
FMC_USERNAME=api_user
FMC_PASSWORD=your_password_here

# Optional: SSL verification (defaults to false for lab environments)
# FMC_VERIFY_SSL=false

# Optional: Override domain UUID (auto-discovered if not set)
# FMC_DOMAIN_UUID=e276abec-e0f2-11e3-8169-6d9ed49b625f

# Optional: Request timeout in seconds (default: 60)
# FMC_TIMEOUT=60

# Optional: Rate limiting (defaults match FMC API limits)
# FMC_RATE_LIMIT=120
# FMC_MAX_CONNECTIONS=10

# Optional: MCP Transport mode (default: stdio)
# Set to 'http' for HTTP/SSE mode (enables integration testing and multiple clients)
# Set to 'stdio' for Claude Desktop compatibility (default)
# MCP_TRANSPORT=stdio

# Optional: HTTP server configuration (only used when MCP_TRANSPORT=http)
# MCP_HOST=127.0.0.1
# MCP_PORT=8080
